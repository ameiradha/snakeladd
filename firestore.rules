rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 256;

      allow update: if isOwner(userId) && isValidId(userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email;

      allow delete: if false;

      // User's Private Quizzes Subcollection
      match /quizzes/{quizId} {
        allow get, delete: if isOwner(userId) && isValidId(quizId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(quizId)
          && incoming().userId == request.auth.uid
          && incoming().userEmail is string
          && incoming().userEmail.size() <= 256
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 256
          && incoming().questions is list
          && incoming().questions.size() <= 100;

        allow update: if isOwner(userId) && isValidId(quizId)
          && incoming().userId == existing().userId
          && incoming().userEmail == existing().userEmail
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 256
          && incoming().questions is list
          && incoming().questions.size() <= 100;
      }
    }
  }
}
