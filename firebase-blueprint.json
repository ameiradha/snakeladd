{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile document storing basic authenticated user info",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Educational board game quiz owned exclusively by the authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "language": { "type": "string", "maxLength": 32 },
        "questions": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "userEmail", "title", "questions"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private profile for each authenticated user"
    },
    "/users/{userId}/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Private quiz collection strictly accessible and manageable only by the owner user"
    }
  }
}
